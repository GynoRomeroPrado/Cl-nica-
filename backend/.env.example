# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Configuration (Upstash or local)
REDIS_URL=redis://localhost:6379
# For Upstash Redis:
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ExerciseDB API (RapidAPI)
RAPIDAPI_KEY=your-rapidapi-key
EXERCISEDB_URL=https://exercisedb.p.rapidapi.com/exercises

# NewsAPI Configuration
NEWS_API_KEY=your-newsapi-key
NEWS_API_URL=https://newsapi.org/v2

# PubMed API Configuration (optional)
PUBMED_API_KEY=
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# ZenQuotes API
ZENQUOTES_URL=https://zenquotes.io/api

# ML Service Configuration (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_TTL=900000
RATE_LIMIT_MAX=100

# Cache Configuration
CACHE_TTL=300
CACHE_MAX=100

# Logging
LOG_LEVEL=debug

# Monitoring & Analytics (optional)
SENTRY_DSN=
MIXPANEL_TOKEN=

# Email Configuration (for password reset, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@healthapp.com
